# ---- Server -------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Required in production. Generate one with:  openssl rand -hex 32
SESSION_SECRET=
# Set to true when running behind a reverse proxy / hosting platform (Render, Railway, Nginx...)
TRUST_PROXY=false

# ---- Admin ---------------------------------------------------------------
# Only this Google account sees the Admin tab and can change laptops.
ADMIN_EMAIL=ramezmilab@gmail.com

# ---- Google Sign-In (https://console.cloud.google.com/apis/credentials) ---
# Create an "OAuth client ID" of type "Web application" and add your site URL
# (and http://localhost:3000 for testing) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# ---- Robin AI (https://console.anthropic.com) -----------------------------
# Optional. Without a key Robin uses the built-in rule-based advisor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Optional --------------------------------------------------------------
# Where laptops.json is stored (use a persistent disk in production).
# DATA_DIR=./data
# Extra allowed origins for state-changing requests, comma separated.
# ALLOWED_ORIGINS=
# Local testing only: sign in as any e-mail without Google. Ignored/forbidden in production.
DEV_AUTH=false
